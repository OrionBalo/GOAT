# Copy to .env and fill in. .env is gitignored -- never commit it.
# On GitHub these same six names become repository secrets.

# From https://www.reddit.com/prefs/apps  (create an app of type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit throttles generic agents. Keep this exact shape:
REDDIT_USER_AGENT=local:goat-notification:v1 (by /u/your_reddit_username)

# From @BotFather, then `python tools/get_chat_id.py`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated. "u/name" and bare "name" both work.
WATCH_USERS=Novel_Calendar5168,CSmith20001

# Optional knobs (defaults shown)
# STATE_PATH=.state/state.json
# FETCH_LIMIT=25
# SNIPPET_CHARS=300
# HEARTBEAT_DAYS=7
# DRY_RUN=0
# LOG_LEVEL=INFO
